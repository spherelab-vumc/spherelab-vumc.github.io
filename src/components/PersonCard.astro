---
import type { Person } from '../lib/data';
import { initials, url } from '../lib/data';

interface Props { person: Person }
const { person } = Astro.props;
const d = person.data;
const years = d.until ? `${d.since ?? ''}–${d.until}` : d.since ? `since ${d.since}` : '';
---
<a class="card" href={url(`/people/${person.id}/`)}>
  {d.photo ? (
    <img class="portrait" src={url(d.photo)} alt={`Portrait of ${d.name}`} loading="lazy" />
  ) : (
    <div class="portrait" aria-hidden="true">{initials(d.name)}</div>
  )}
  <span class="name">{d.name}</span>
  <span class="role">{d.title}{d.program && d.role !== 'alumni' ? `, ${d.program}` : ''}</span>
  {d.now && <span class="now">Now: {d.now}</span>}
  {years && <span class="meta-row"><span>{years}</span></span>}
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none; color: var(--ink); }
  .card:hover .name { color: var(--accent-ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .card:hover .portrait { border-color: var(--accent); }
  .portrait { margin-bottom: 0.6rem; transition: border-color 0.2s; }
  .name { font-family: var(--serif); font-size: 1.15rem; line-height: 1.25; }
  .role, .now { font-family: var(--sans); font-size: 0.8rem; color: var(--ink-2); line-height: 1.4; }
  .now { color: var(--muted); }
  .meta-row { display: flex; gap: 0.8rem; font-family: var(--mono); font-size: 0.7rem; color: var(--muted); margin-top: 0.15rem; }
</style>
