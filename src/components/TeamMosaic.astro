---
/**
 * Grid of current members' portraits for the Home page. The PI tile spans 2×2.
 * Uses each person's `photo`, or their initials when there is none.
 */
import { loadAll, initials, url } from '../lib/data';

const { people } = await loadAll();
const current = people.filter((p) => p.data.role !== 'alumni');
const pi = current.find((p) => p.data.role === 'pi');
const others = current.filter((p) => p.data.role !== 'pi');
const tiles = pi ? [pi, ...others] : others;
---
<figure class="mosaic">
  <ul class="tiles">
    {tiles.map((p) => (
      <li class:list={[{ lead: p.data.role === 'pi' }]}>
        <a href={url(`/people/${p.id}/`)} aria-label={`${p.data.name}, ${p.data.title}`}>
          {p.data.photo ? (
            <img src={url(p.data.photo)} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="mono-tile" aria-hidden="true">{initials(p.data.name)}</span>
          )}
          <span class="tip" aria-hidden="true">{p.data.name}</span>
        </a>
      </li>
    ))}
  </ul>
  <figcaption>
    <a href={url('/people/')}>{current.length} researchers across computer science, engineering, and biomedical informatics →</a>
  </figcaption>
</figure>

<style>
  .mosaic { margin: 0; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .tiles li { position: relative; aspect-ratio: 4 / 5; }
  .tiles li.lead { grid-column: span 2; grid-row: span 2; }
  .tiles a { display: block; width: 100%; height: 100%; position: relative; overflow: hidden; border-radius: 4px; background: var(--paper-2); }
  .tiles img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.35s ease, filter 0.35s ease; filter: saturate(0.92); }
  .mono-tile { width: 100%; height: 100%; display: grid; place-items: center; font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--accent); background: var(--accent-soft); }
  .tip {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem 0.45rem 0.35rem;
    font-family: var(--sans); font-size: 0.68rem; line-height: 1.2; color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
    opacity: 0; transform: translateY(4px); transition: opacity 0.25s, transform 0.25s;
  }
  .lead .tip { font-size: 0.8rem; padding: 2rem 0.6rem 0.5rem; }
  .tiles a:hover img, .tiles a:focus-visible img { transform: scale(1.04); filter: saturate(1.05); }
  .tiles a:hover .tip, .tiles a:focus-visible .tip { opacity: 1; transform: none; }
  .tiles a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (hover: none) { .lead .tip { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .tiles img, .tip { transition: none; } }
  figcaption { margin-top: 0.7rem; font-family: var(--sans); font-size: 0.82rem; }
  figcaption a { color: var(--ink-2); }
  figcaption a:hover { color: var(--accent-ink); }
</style>
