---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import TeamMosaic from '../components/TeamMosaic.astro';
import FeaturedPapers from '../components/FeaturedPapers.astro';
import { getCollection } from 'astro:content';
import { site, loadAll, url, fmtMonth, roman, statValue, homeSection, numberWord, programColor } from '../lib/data';

const all = await loadAll();
const { programs, directions, pubs, memberKeys, piKey } = all;
const home = site.home;
const S = {
  programs: homeSection('programs', 'Research programs'),
  featured: homeSection('featured', 'Featured work', 3),
  news: homeSection('news', 'News', 4),
  recent: homeSection('recent', 'Recent papers', 5),
};
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, S.news.count);
const recent = pubs.filter((p) => p.type !== 'abstract' && p.labLed && !p.featured).slice(0, S.recent.count);
---
<Base>
  <div class="wrap">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-text">
        <p class="kicker">{site.labFullName} · {site.institution}</p>
        <h1>{home.headline}</h1>
        {home.mission && <p class="lede">{home.mission}</p>}
        {home.buttons && home.buttons.length > 0 && (
          <p class="cta">
            {home.buttons.map((b) => <a class:list={['btn', { primary: b.primary }]} href={url(b.href)}>{b.label}</a>)}
          </p>
        )}
      </div>
      <div class="hero-team"><TeamMosaic /></div>
    </section>

    <!-- Numbers -->
    <ul class="numbers" aria-label="The lab in numbers">
      {site.stats.map((s) => (
        <li><span class="n">{statValue(s.value, all)}</span><span class="l">{s.label}</span></li>
      ))}
    </ul>

    <!-- Programs teaser -->
    <section class="section">
      <div class="section-head"><h2>{S.programs.title}</h2></div>
      <ul class="programs">
        {programs.map((p, i) => {
          const n = directions.filter((d) => d.data.program === p.id).length;
          return (
            <li style={`--c: ${programColor(i)}`}>
              <a href={url(`/research/#program-${p.id}`)}>
                <span class="p-num">Program {roman(p.data.number)}</span>
                <span class="p-title">{p.data.title}</span>
                <span class="p-sum">{p.data.summary}</span>
                <span class="p-more">{numberWord(n)} direction{n === 1 ? '' : 's'} →</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Featured work -->
    <section class="section">
      <FeaturedPapers count={S.featured.count} title={S.featured.title} />
    </section>

    <!-- News + recent papers -->
    <section class="section split">
      <div>
        <div class="section-head"><h2>{S.news.title}</h2></div>
        <ul class="news">
          {news.map((n) => (
            <li>
              <time datetime={n.data.date.toISOString()}>{fmtMonth(n.data.date)}</time>
              <span>{n.data.title}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="section-head"><h2>{S.recent.title}</h2></div>
        <ul class="plain">
          {recent.map((p) => <PubItem pub={p} memberKeys={memberKeys} piKey={piKey} compact />)}
        </ul>
        <p><a class="more" href={url('/publications/')}>All {pubs.length} publications →</a></p>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hero */
  .hero { display: grid; gap: 2.5rem; padding: 4rem 0 2.5rem; align-items: center; }
  @media (min-width: 960px) { .hero { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 3.5rem; } }
  .hero h1 { font-size: clamp(1.8rem, 3.3vw, 2.55rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0.8rem 0 1.2rem; }
  .hero .lede { font-size: 1.2rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 1.6rem 0 0; }
  .btn {
    font-family: var(--sans); font-size: 0.9rem; font-weight: 500; text-decoration: none;
    padding: 0.7rem 1.15rem; border-radius: 6px; border: 1px solid var(--ink); color: var(--ink);
    transition: background 0.2s, color 0.2s;
  }
  .btn:hover { background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink); }
  .btn.primary { background: var(--ink); color: var(--paper); }
  .btn.primary:hover { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .hero-team { width: 100%; max-width: 460px; justify-self: center; }

  /* Numbers strip */
  .numbers { list-style: none; margin: 0 0 1rem; padding: 1.4rem 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem 1rem; border-top: 1px solid var(--ink); }
  @media (min-width: 760px) { .numbers { grid-template-columns: repeat(4, 1fr); } }
  .numbers li { display: flex; flex-direction: column; gap: 0.15rem; }
  .numbers .n { font-family: var(--serif); font-size: clamp(1.8rem, 3.4vw, 2.5rem); line-height: 1; color: var(--ink); }
  .numbers .l { font-family: var(--sans); font-size: 0.78rem; color: var(--muted); }

  /* Programs teaser */
  .programs { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 860px) { .programs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .programs a { display: flex; flex-direction: column; gap: 0.5rem; height: 100%; padding-top: 0.9rem; border-top: 3px solid var(--c); text-decoration: none; color: var(--ink); }
  .p-num { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-ink); }
  .p-title { font-family: var(--serif); font-size: 1.35rem; line-height: 1.2; transition: color 0.2s; }
  .p-sum { font-family: var(--sans); font-size: 0.84rem; line-height: 1.55; color: var(--muted); }
  .p-more { margin-top: auto; font-family: var(--sans); font-size: 0.82rem; color: var(--ink-2); }
  .programs a:hover .p-title { color: var(--accent-ink); }
  .programs a:hover .p-more { color: var(--c-ink); }

  /* News + recent */
  .split { display: grid; gap: 2rem 4rem; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1.3fr; } }
  .news { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--ink); }
  .news li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.8rem; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); font-size: 1rem; line-height: 1.4; }
  .news time { font-family: var(--mono); font-size: 0.72rem; color: var(--accent); padding-top: 0.25rem; text-transform: uppercase; }
</style>
