---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import ConnectionMap from '../../components/ConnectionMap.astro';
import { render } from 'astro:content';
import { loadAll, ROLE_ORDER, ROLE_LABEL, initials, url, mentees } from '../../lib/data';

const { people, pubs } = await loadAll();
const pi = people.find((p) => p.data.role === 'pi')!;
const { Content: PiBio } = await render(pi);
const groups = ROLE_ORDER.filter((r) => r !== 'pi')
  .map((r) => ({ role: r, list: people.filter((p) => p.data.role === r) }))
  .filter((g) => g.list.length);
---
<Base title="People" description="Members and alumni of the SPHERE Lab.">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">People</p>
      <h1>The team</h1>
    </header>

    <section class="section folio pi">
      <div class="pi-grid">
        {pi.data.photo ? (
          <img class="portrait" src={url(pi.data.photo)} alt={`Portrait of ${pi.data.name}`} />
        ) : (
          <div class="portrait" aria-hidden="true">{initials(pi.data.name)}</div>
        )}
        <div>
          <p class="kicker">{ROLE_LABEL.pi}</p>
          <h2><a href={url(`/people/${pi.id}/`)}>{pi.data.name}{pi.data.credentials && `, ${pi.data.credentials}`}</a></h2>
          <p class="role">{pi.data.title}</p>
          <div class="prose"><PiBio /></div>
        </div>
      </div>
      {pi.data.education.length > 0 && (
        <aside class="sidenote">
          <strong>Education</strong>
          {pi.data.education.map((e) => <><br />{e}</>)}
        </aside>
      )}
    </section>

    {groups.map((g) => (
      <>
      {g.role === 'alumni' && (
        <section class="section">
          <div class="section-head"><h2>Who works on what</h2></div>
          <ConnectionMap />
        </section>
      )}
      <section class="section">
        <div class="section-head"><span class="section-num">{g.list.length}</span><h2>{ROLE_LABEL[g.role]}</h2></div>
        <div class="grid">
          {g.list.map((p) => <PersonCard person={p} />)}
        </div>
        {g.role === 'alumni' && mentees.length > 0 && (
          <div class="mentees">
            <h3>Former students &amp; interns</h3>
            <ul>
              {mentees.map((m) => (
                <li>
                  <span class="m-years">{m.years}</span>
                  <span class="m-body">
                    <span class="m-name">{m.name}</span>
                    <span class="m-role">{m.role}{m.affiliation && `, ${m.affiliation}`}</span>
                    {m.topic && <span class="m-topic">{m.topic}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
      </>
    ))}

    <section class="section folio">
      <div>
        <p>Interested in joining? See <a href={url('/join/')}>Join &amp; Contact</a>.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-head { padding: 4rem 0 1rem; }
  .page-head h1 { margin-top: 0.6rem; }
  .pi-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 640px) { .pi-grid { grid-template-columns: 11rem 1fr; gap: 2rem; } }
  .pi-grid .portrait { max-width: 11rem; }
  .pi h2 { margin: 0.3rem 0 0.3rem; }
  .pi h2 a { color: var(--ink); text-decoration: none; }
  .pi h2 a:hover { color: var(--accent-ink); }
  .role { font-family: var(--sans); font-size: 0.9rem; color: var(--muted); }
  .mentees { margin-top: 2.8rem; }
  .mentees h3 { font-family: var(--sans); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.6rem; }
  .mentees ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); display: grid; column-gap: 2.5rem; }
  @media (min-width: 820px) { .mentees ul { grid-template-columns: 1fr 1fr; } }
  .mentees li { display: grid; grid-template-columns: 5.8rem 1fr; gap: 0.8rem; padding: 0.75rem 0; border-bottom: 1px solid var(--rule); }
  .m-years { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); padding-top: 0.2rem; }
  .m-body { display: flex; flex-direction: column; gap: 0.1rem; }
  .m-name { font-family: var(--serif); font-size: 1.05rem; color: var(--ink); }
  .m-role { font-family: var(--sans); font-size: 0.8rem; color: var(--ink-2); }
  .m-topic { font-family: var(--serif); font-style: italic; font-size: 0.88rem; color: var(--muted); line-height: 1.4; }
</style>
