---
import '../styles/fonts.css';
import '../styles/global.css';
import { site, url } from '../lib/data';
import Email from '../components/Email.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.home.headline } = Astro.props;
const pageTitle = title ? `${title} · ${site.labName}` : `${site.labName} · ${site.labFullName}`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
// Absolute URLs for link previews (Slack, LinkedIn, X, email) and search engines
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og.jpg'), Astro.site).href;
const nav = site.nav;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.labName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.labName}: ${site.home.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0e6662" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Apply the saved light/dark choice before the page paints.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label={`${site.labName} home`}>
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.6"/><ellipse cx="16" cy="16" rx="13" ry="5" fill="none" stroke="currentColor" stroke-width="1.2"/><ellipse cx="16" cy="16" rx="5" ry="13" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="16" cy="16" r="2.4" fill="currentColor"/></svg>
          </span>
          <span class="brand-text">
            <span class="brand-name"><span class="hash" aria-hidden="true">#</span>{site.labName}</span>
            {site.subtitle && <span class="brand-sub">{site.subtitle}</span>}
          </span>
        </a>
        <nav aria-label="Main">
          <button class="menu-btn" aria-expanded="false" aria-controls="nav-list">Menu</button>
          <ul id="nav-list">
            {nav.map((n) => (
              <li>
                <a href={url(n.href)} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
            <li>
              <button class="theme-btn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap foot">
        <div>
          <p class="foot-name"><span class="hash" aria-hidden="true">#</span>{site.labName}</p>
          <p class="muted">{site.labFullName}<br />{site.institution}</p>
        </div>
        <div class="foot-links">
          <Email address={site.contact.email} />
          {site.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
        </div>
        <p class="muted small">© {site.founded ? `${site.founded}–present` : ""} {site.labName}</p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector('.theme-btn')?.addEventListener('click', () => {
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
      });
    </script>
  </body>
</html>

<style>
  header.site {
    position: sticky; top: 0; z-index: 5;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.25rem; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--ink); }
  .mark { color: var(--accent); display: grid; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name { font-family: var(--serif); font-size: 1.3rem; font-weight: 500; letter-spacing: -0.01em; }
  /* Decorative hashtag: a nod to the lab's social-computing roots (hidden from screen readers) */
  .hash { color: var(--accent); font-weight: 400; margin-right: 0.06em; }
  .brand-sub { font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

  nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 1.6rem; }
  nav a { font-family: var(--sans); font-size: 0.88rem; color: var(--ink-2); text-decoration: none; padding: 0.3rem 0; border-bottom: 1px solid transparent; }
  nav a:hover { color: var(--accent-ink); }
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  .theme-btn, .menu-btn {
    background: none; border: 1px solid var(--rule); color: var(--ink-2); border-radius: 999px;
    cursor: pointer; font-family: var(--sans); font-size: 0.85rem;
  }
  .theme-btn { width: 2.2rem; height: 2.2rem; display: grid; place-items: center; }
  .menu-btn { display: none; padding: 0.4rem 0.9rem; border-radius: 6px; }

  @media (max-width: 860px) {
    .menu-btn { display: inline-block; }
    nav ul {
      display: none; position: absolute; left: 0; right: 0; top: 4.25rem;
      flex-direction: column; align-items: flex-start; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--rule); padding: 0.5rem 1rem 1rem;
    }
    nav li { width: 100%; }
    nav a { display: block; padding: 0.75rem 0; font-size: 1rem; }
    .menu-btn[aria-expanded='true'] + ul { display: flex; }
    .theme-btn { margin-top: 0.5rem; }
  }

  footer.site { border-top: 1px solid var(--rule); margin-top: 5rem; padding: 2.5rem 0 3rem; background: var(--paper-2); }
  .foot { display: grid; gap: 1.5rem; font-family: var(--sans); font-size: 0.85rem; }
  @media (min-width: 720px) { .foot { grid-template-columns: 2fr 1fr; } .small { grid-column: 1 / -1; } }
  .foot-name { font-family: var(--serif); font-size: 1.2rem; margin-bottom: 0.3rem; }
  .foot-links { display: flex; flex-direction: column; gap: 0.4rem; }
  .small { font-size: 0.75rem; margin: 0; }
</style>
